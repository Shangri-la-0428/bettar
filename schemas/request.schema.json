              },
              "intent": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "event_start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              },
              "event_end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 31
              }
            },
            "required": [
              "id",
              "label",
              "intent",
              "event_start",
              "event_end"
            ]
          }
        }
      },
      "required": [
        "title",
        "intent",
        "phases",
        "zone_placement_ids",
        "top_placement_ids",
        "source",
        "disclaimer"
      ]
    },
    "route_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_goal",
        "rhythm",
        "source",
        "search",
        "phases"
      ],
      "properties": {
        "style_goal": {
          "enum": [
            "power",
            "sustained",
            "technical"
          ]
        },
        "rhythm": {
          "enum": [
            "early_crux",
            "late_crux",
            "sustained"
          ]
        },
        "source": {
          "const": "synthetic_assumption"
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "beam_width",
            "max_expansions"
          ],
          "properties": {
            "beam_width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            },
            "max_expansions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "hand_move_index",
              "target"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "hand_move_index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 11
              },
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "strength",
                  "power",
                  "technical",
                  "load"
                ],
                "properties": {
                  "strength": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "power": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "technical": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "load": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                }
              },
              "segment_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "phase_kind": {
                "enum": [
                  "establish",
                  "power",
                  "technical",
                  "relief",
                  "sustained",
                  "finish"
                ]
              }
            }
          }
        },
        "program": {
          "enum": [
            "mixed_flow",
            "power_finish",
            "sustained_finish"
          ]
        }
      }
    },
    "setting_design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program",
        "source",
        "intent",
        "search"
      ],
      "properties": {
        "program": {
          "enum": [
            "diagonal_balance",
            "opposing_sidepulls",
            "roof_exit"
          ]
        },
        "source": {
          "const": "synthetic_assumption"
        },
        "intent": {
          "type": "string",
          "maxLength": 600
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "geometry_trials",
            "max_expansions",
            "beam_width"
          ],
          "properties": {
            "geometry_trials": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "max_expansions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 60000
            },
            "beam_width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 128
            }
          }
        },
        "hold_source": {
          "enum": [
            "templates",
            "assets"
          ]
        },
        "asset_application": {
          "type": "object"
        },
        "wall_profile": {
          "enum": [
            "default",
            "overhang",
            "roof",
            "dihedral",
            "arete"
          ]
        },
        "wall_application": {
          "type": "object"
        }
      }
    },
    "route_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_contacts"],
      "properties": {
        "allowed_contacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["LH", "RH", "LF", "RF"],
          "properties": {
            "LH": {"$ref": "#/$defs/contactPlacementIds"},
            "RH": {"$ref": "#/$defs/contactPlacementIds"},
            "LF": {"$ref": "#/$defs/contactPlacementIds"},
            "RF": {"$ref": "#/$defs/contactPlacementIds"}
          }
        }
      }
    },
    "mechanics_parameters": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "id",
    "revision",
    "source",
    "scene",
    "body",
    "scenario",
    "mode",
    "hand_moves",
    "seed",
    "budget",
    "solver",
    "reference_layout",
    "start_contacts",
    "end_contacts"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "contactPlacementIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "setting"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "required": [
          "setting_design"
        ],
        "properties": {
          "scenario": {
            "const": "setting_search"
          },
          "mode": {
            "const": "free"
          },
          "scene": {
            "properties": {
              "width": {
                "const": 4.8
              },
              "height": {
                "const": 4.2
              }
            }
          }
        }
      },
      "else": {
        "allOf": [
          {
            "if": {
              "properties": {
                "scenario": {
                  "const": "competition_sequence"
                }
              },
              "required": [
                "scenario"
              ]
            },
            "then": {
              "properties": {
                "profile": {
                  "const": "competition"
                },
                "hand_moves": {
                  "const": 4
                },
                "scene": {
                  "properties": {
                    "width": {
                      "const": 4.8
                    },
                    "height": {
                      "const": 4.2
                    }
                  }
                }
              },
              "required": [
                "profile"
              ]
            },
            "else": {
              "if": {
                "properties": {
                  "profile": {
                    "const": "route"
                  }
                },
                "required": [
                  "profile"
                ]
              },
              "then": {
                "properties": {
                  "scene": {
                    "properties": {
                      "width": {
                        "const": 4.8
                      },
                      "height": {
                        "const": 4.2
                      }
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "profile": {
                    "enum": [
                      "basic",
                      "catalog",
                      "style"
                    ]
                  },
                  "scene": {
                    "properties": {
                      "width": {
                        "const": 3
                      },
                      "height": {
                        "const": 3
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "profile": {
                  "const": "competition"
                }
              },
              "required": [
                "profile"
              ]
            },
            "then": {
              "properties": {
                "scenario": {
                  "const": "competition_sequence"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "profile": {
                  "const": "catalog"
                }
              },
              "required": [
                "profile"
              ]
            },
            "then": {
              "properties": {
                "scene": {
                  "required": [
                    "catalog_stock"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "profile": {
                  "const": "style"
                }
              },
              "required": [
                "profile"
              ]
            },
            "then": {
              "required": [
                "route_design"
              ],
              "properties": {
                "scenario": {
                  "const": "style_search"
                },
                "mode": {
                  "const": "fixed"
                },
                "hand_moves": {
                  "const": 4
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "profile": {
                    "const": "route"
                  }
                },
                "required": [
                  "profile"
                ]
              },
              "then": {
                "required": [
                  "route_design"
                ],
                "properties": {
                  "scenario": {
                    "const": "route_search"
                  },
                  "mode": {
                    "const": "free"
                  },
                  "hand_moves": {
                    "enum": [
                      8,
                      10,
                      12
                    ]
                  },
                  "route_design": {
                    "required": [
                      "program"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "scene": {
                    "properties": {
                      "angle_deg": {
                        "maximum": 10
                      }
                    }
                  },
                  "scenario": {
                    "not": {
                      "const": "style_search"
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "profile": {
                  "enum": [
                    "basic",
                    "catalog"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "hand_moves": {
                  "maximum": 4
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "scenario": {
                  "const": "route_search"
                }
              },
              "required": [
                "scenario"
              ]
            },
            "then": {
              "properties": {
                "profile": {
                  "const": "route"
                }
              },
              "required": [
                "profile"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "scenario": {
            "const": "setting_search"
          }
        },
        "required": [
          "scenario"
        ]
      },
      "then": {
        "required": [
          "profile"
        ],
        "properties": {
          "profile": {
            "const": "setting"
          }
        }
      }
    }
  ]
}
